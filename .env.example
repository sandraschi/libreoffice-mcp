# LibreOffice MCP — environment template
# Copy to .env and adjust paths for your machine.

LIBREOFFICE_MCP_SOFFICE_PATH=
LIBREOFFICE_MCP_EXTENSION_BRIDGE_URL=http://127.0.0.1:8765/mcp
LIBREOFFICE_MCP_CENTRAL_DOCS_PATH=D:\Dev\repos\mcp-central-docs
LIBREOFFICE_MCP_OLLAMA_BASE_URL=http://127.0.0.1:11434
LIBREOFFICE_MCP_OLLAMA_MODEL=qwen3.5:27b
LIBREOFFICE_MCP_LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LIBREOFFICE_MCP_OPENAI_API_KEY=
LIBREOFFICE_MCP_OPENAI_MODEL=gpt-4o-mini

# Sampling / agentic workflow (SEP-1577) — default local Ollama OpenAI-compatible API
LIBREOFFICE_MCP_SAMPLING_BASE_URL=http://127.0.0.1:11434/v1
LIBREOFFICE_MCP_SAMPLING_MODEL=qwen3.5:27b
# LIBREOFFICE_MCP_SAMPLING_USE_CLIENT_LLM=1
# LIBREOFFICE_MCP_PREFAB_APPS=1

# Data dirs (defaults under ~/.libreoffice-mcp/)
# LIBREOFFICE_MCP_OUTPUT_DIR=
# LIBREOFFICE_MCP_UPLOAD_DIR=
# LIBREOFFICE_MCP_CONVERT_TIMEOUT_SEC=120
# LIBREOFFICE_MCP_WATCH_POLL_SEC=5
# LIBREOFFICE_MCP_MAX_UPLOAD_BYTES=52428800
